<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12"
                    Condition="'$(MSBuildProjectName)' == 'LogicGate.SiteFactory.Runtime.Hosting.Tests' Or '$(MSBuildProjectName)' == 'LogicGate.SiteFactory.Infrastructure.PostgreSql.Tests'" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12"
                    Condition="'$(MSBuildProjectName)' == 'LogicGate.SiteFactory.Runtime.Hosting' Or '$(MSBuildProjectName)' == 'LogicGate.SiteFactory.Infrastructure.PostgreSql'" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12"
                    Condition="'$(MSBuildProjectName)' == 'LogicGate.SiteFactory.Runtime.Hosting' Or '$(MSBuildProjectName)' == 'LogicGate.SiteFactory.Infrastructure.PostgreSql'" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12"
                    Condition="'$(MSBuildProjectName)' == 'LogicGate.SiteFactory.Runtime.Hosting'" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12"
                    Condition="'$(MSBuildProjectName)' == 'LogicGate.SiteFactory.Runtime.Hosting'" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3"
                    Condition="'$(MSBuildProjectName)' == 'LogicGate.SiteFactory.Infrastructure.PostgreSql' Or '$(MSBuildProjectName)' == 'LogicGate.SiteFactory.Infrastructure.PostgreSql.Tests' Or '$(MSBuildProjectName)' == 'LogicGate.SiteFactory.Runtime.PostgreSql.Hosts.Tests'" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
