    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LogicGate.SiteFactory.Infrastructure/LogicGate.SiteFactory.Infrastructure.csproj" />
    <ProjectReference Include="../../src/LogicGate.SiteFactory.Modules.Documentation/LogicGate.SiteFactory.Modules.Documentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../fixtures/public/generation-plan/valid-minimal/generation-plan.json"
          Link="fixtures/generation-plan/valid-minimal/generation-plan.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/public/sitefactory-lock/valid-minimal/sitefactory.lock.json"
          Link="fixtures/sitefactory-lock/valid-minimal/sitefactory.lock.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/public/generation-report/first-generation.json"
          Link="fixtures/generation-report/first-generation.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
