<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <StartupObject>LogicGate.SiteFactory.Cli.Tests.RuntimeContractsTestEntryPoint</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LogicGate.SiteFactory.Runtime.Contracts/LogicGate.SiteFactory.Runtime.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share only the existing BCL-only test supervisor, not the CLI assembly or its composition. -->
    <Compile Include="../LogicGate.SiteFactory.Cli.Tests/OwnedProcessRunner.cs" Link="ProcessHelpers/OwnedProcessRunner.cs" />
    <Compile Include="../LogicGate.SiteFactory.Cli.Tests/OwnedProcessScope.cs" Link="ProcessHelpers/OwnedProcessScope.cs" />
  </ItemGroup>
</Project>
