<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Markdig" />
      <package pattern="Microsoft.*" />
      <package pattern="Microsoft.Extensions.Hosting" />
      <package pattern="Npgsql" />
      <package pattern="Npgsql.EntityFrameworkCore.PostgreSQL" />
      <package pattern="System.Diagnostics.EventLog" />
      <package pattern="YamlDotNet" />
      <package pattern="xunit*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
